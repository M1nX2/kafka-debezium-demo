{
  "name": "products-connector-ms-sql",
  "config": {
    "connector.class": "io.debezium.connector.sqlserver.SqlServerConnector",
    "database.hostname": "mssql",
    "database.port": "1433",
    "database.user": "sa",
    "database.password": "StrongP@ssw0rd",
    "database.dbname": "productsdb",
    "database.names": "productsdb",
    "database.cdcschema": "cdc",
    "database.server.name": "dbserver1",
    "topic.prefix": "debezium-source",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": true,
    "schema.history.internal.kafka.topic": "schema-changes.productsdb",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:29092",
    "heartbeat.interval.ms": "5000",
    "transforms": "unwrap,RouteToSink",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.add.fields": "op,table,source.ts_ms",
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "transforms.unwrap.drop.tombstones": "true",
    "transforms.RouteToSink.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.RouteToSink.regex": "debezium-source\\.(.*)",
    "transforms.RouteToSink.replacement": "debezium-sync.$1",
    "tombstones.on.delete": false,
    "null.handling.mode": "keep",
    "database.ssl": "true",
    "database.sslmode": "allow",
    "database.trustServerCertificate": "true",
    "topic.creation.default.replication.factor": 1,
    "topic.creation.default.partitions": 1
  }
}
